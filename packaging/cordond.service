[Unit]
Description=cordon, per-owner workspace isolation
Documentation=https://github.com/fajarhide/cordon
After=network.target

[Service]
# A dedicated user. Create it with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin cordon
User=cordon
Group=cordon

# The container backend needs this user in the docker group. Be aware that
# membership of the docker group is equivalent to root on the host, so a
# deployment that only uses the process backend should leave it out.
#SupplementaryGroups=docker

ExecStart=/usr/local/bin/cordon serve
Restart=on-failure
RestartSec=2

Environment=CORDON_ROOT=/var/lib/cordon
Environment=CORDON_LISTEN=unix:/run/cordond/cordond.sock
RuntimeDirectory=cordond
RuntimeDirectoryMode=0750
StateDirectory=cordon
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/cordon

[Install]
WantedBy=multi-user.target
